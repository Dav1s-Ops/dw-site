---
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/dw/PostCard.astro';
import { getPosts } from '@/lib/posts';
const latest = (await getPosts()).slice(0, 3);
---
<Base title="Home">
  <section class="w-full rounded-xl border border-gray bg-ink-spot px-6 py-16 text-center shadow-glow-green">
    <h1 class="font-display text-[clamp(2rem,7vw,3.5rem)] font-semibold">Davis Weimer</h1>
    <p class="mt-3 font-display text-sm font-light text-electro-green">Fullstack developer</p>
  </section>
  <section class="flex w-full max-w-[825px] flex-col gap-4">
    <h2 class="font-display text-lg">Latest posts</h2>
    {latest.map((post) => <PostCard post={post} />)}
  </section>
</Base>