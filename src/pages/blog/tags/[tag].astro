---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/dw/PostCard.astro';
import { getPosts, tagSlug } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const tags = new Map<string, string>(); // slug -> display name
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(tagSlug(t), t)));
  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)) },
  }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
---
<Base title={`#${name}`}>
  <h1 class="font-display text-2xl">#{name}</h1>
  <section class="flex w-full max-w-[825px] flex-col gap-4">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</Base>