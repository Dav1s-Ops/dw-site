---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import CategoryBar from '@/components/dw/CategoryBar.astro';
import PostCard from '@/components/dw/PostCard.astro';
import { getPosts } from '@/lib/posts';
import Search from 'astro-pagefind/components/Search.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  // /blog, /blog/2, /blog/3 ...
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<Base title="Blog">
  <div class="flex w-full flex-col items-center gap-6">
    <CategoryBar />
    <div class="w-full max-w-[825px]"><Search className="pagefind-search" /></div>
    <ul class="flex w-full max-w-[825px] flex-col gap-4">
      {page.data.map((post) => <li><PostCard post={post} /></li>)}
    </ul>
    {page.lastPage > 1 && (
      <nav aria-label="Pagination" class="flex items-center gap-4 font-display text-sm">
        {page.url.prev ? <a href={page.url.prev} class="hover:text-electro-green">← Newer</a> : <span class="text-gray">← Newer</span>}
        <span class="text-gray-light">{page.currentPage} / {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next} class="hover:text-electro-green">Older →</a> : <span class="text-gray">Older →</span>}
      </nav>
    )}
  </div>
</Base>
