---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
const jobs = (await getCollection('work')).sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Work">
  <h1 class="font-display text-3xl font-semibold">Work</h1>
  <ol class="relative w-full max-w-3xl border-l border-gray pl-6 md:pl-10">
    {jobs.map(({ data: j }) => (
      <li class="relative mb-10">
        <span class="absolute -left-[31px] top-2 size-3 rounded-full bg-electro-green shadow-glow-green md:-left-[47px]"></span>
        <p class="font-display text-xs font-light text-electro-green">{fmt(j.start)} – {j.end ? fmt(j.end) : 'Present'}</p>
        <h2 class="mt-1 font-display text-lg">{j.title} · {j.website ? <a href={j.website} class="hover:text-electro-blue">{j.company}</a> : j.company}</h2>
        <p class="mt-2 font-light text-gray-light">{j.summary}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {j.stack.map((s) => <li class="rounded-full border border-gray px-2.5 py-0.5 font-mono text-[11px]">{s}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</Base>